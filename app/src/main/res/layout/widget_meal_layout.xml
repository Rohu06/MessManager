<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- ═══════════ HEADER ROW ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- App title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Remaining coupons badge -->
        <TextView
            android:id="@+id/widget_remaining_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_remaining_badge"
            android:text="@string/widget_remaining_default"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ═══════════ PROGRESS BAR ROW ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Progress bar wrapper (we simulate a progress bar since RemoteViews doesn't support
             ClipDrawable on all API levels reliably. We use two FrameLayouts.) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_progress_track">

            <FrameLayout
                android:id="@+id/widget_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_widget_progress_fill" />
        </FrameLayout>

        <!-- Coupon count label -->
        <TextView
            android:id="@+id/widget_coupon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_coupons_default"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- ═══════════ MEAL CARDS ROW ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- ── Lunch Card ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_widget_meal_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Lunch emoji + label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_lunch_label"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Status pill -->
            <TextView
                android:id="@+id/widget_lunch_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_widget_status_pending"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="@string/widget_status_pending"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Mark Lunch Button -->
            <TextView
                android:id="@+id/widget_btn_mark_lunch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_widget_btn"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="@string/widget_mark_lunch"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- ── Dinner Card ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_widget_meal_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Dinner emoji + label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_dinner_label"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Status pill -->
            <TextView
                android:id="@+id/widget_dinner_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_widget_status_pending"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="@string/widget_status_pending"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Mark Dinner Button -->
            <TextView
                android:id="@+id/widget_btn_mark_dinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_widget_btn"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="@string/widget_mark_dinner"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
