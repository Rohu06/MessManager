<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- ═══════════════════════ GRADIENT HERO HEADER ═══════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_history_header"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Top bar: back button + title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/content_desc_back"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="24dp"
                app:iconTint="@color/white" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_meal_history"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Subtitle + entry count row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtitle_meal_history"
                android:textColor="@color/white"
                android:alpha="0.85"
                android:textSize="14sp"
                android:fontFamily="sans-serif" />

            <!-- Entry count badge -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvEntryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_history_count_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                tools:text="24 entries" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════ SEARCH BAR ═══════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_search_history"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:endIconMode="clear_text"
            app:endIconDrawable="@android:drawable/ic_menu_close_clear_cancel"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:paddingVertical="10dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSort"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/action_sort"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconSize="24dp"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

    </LinearLayout>

    <!-- ═══════════════════════ FILTER CHIPS ═══════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:cardCornerRadius="16dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp"
                app:checkedChip="@id/chipAll">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_all"
                    android:checkable="true"
                    app:chipIcon="@android:drawable/ic_menu_view"
                    app:chipIconVisible="true"
                    app:chipIconSize="18dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLunch"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_lunch"
                    android:checkable="true"
                    app:chipIcon="@drawable/ic_lunch"
                    app:chipIconVisible="true"
                    app:chipIconSize="18dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDinner"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_dinner"
                    android:checkable="true"
                    app:chipIcon="@drawable/ic_dinner"
                    app:chipIconVisible="true"
                    app:chipIconSize="18dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSkipped"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_skipped"
                    android:checkable="true"
                    app:chipIcon="@android:drawable/ic_menu_delete"
                    app:chipIconVisible="true"
                    app:chipIconSize="18dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Active filters indicator -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFilterIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="Showing: Lunch only • Sorted newest first" />

    <!-- ═══════════════════════ CONTENT AREA ═══════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- RecyclerView with fade edges -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="16dp"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="48dp"
            android:scrollbars="vertical" />

        <!-- Empty state - redesigned -->
        <LinearLayout
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="48dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_history"
                    android:contentDescription="@string/empty_history_title"
                    android:scaleType="centerInside"
                    android:padding="22dp"
                    app:tint="?attr/colorOnPrimaryContainer" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/empty_history_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/empty_history_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddEntry"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Add Your First Meal"
                app:icon="@android:drawable/ic_input_add"
                app:cornerRadius="24dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>