<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="0.5dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingStart="0dp"
        android:paddingEnd="16dp">

        <!-- ─── Left accent strip ─── -->
        <View
            android:id="@+id/viewAccent"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_history_date_accent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- ─── Date badge ─── -->
        <LinearLayout
            android:id="@+id/dateBadge"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_date_section"
            android:layout_marginStart="14dp"
            app:layout_constraintStart_toEndOf="@id/viewAccent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvDayNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                tools:text="22" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:alpha="0.8"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:includeFontPadding="false"
                tools:text="JUL" />

        </LinearLayout>

        <!-- ─── Full date text ─── -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/dateBadge"
            app:layout_constraintEnd_toStartOf="@id/btnEdit"
            app:layout_constraintTop_toTopOf="@id/dateBadge"
            app:layout_constraintBottom_toTopOf="@id/layoutStatusPills"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Tuesday, 22 July 2026" />

        <!-- ─── Status pills row ─── -->
        <LinearLayout
            android:id="@+id/layoutStatusPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toEndOf="@id/dateBadge"
            app:layout_constraintEnd_toStartOf="@id/btnEdit"
            app:layout_constraintTop_toBottomOf="@id/tvDate">

            <!-- Lunch pill -->
            <LinearLayout
                android:id="@+id/pillLunch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_taken"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/ivLunchIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_lunch"
                    android:contentDescription="@string/label_lunch"
                    app:tint="@color/status_green" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvLunchStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="11sp"
                    android:textColor="@color/status_green"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    tools:text="Lunch ✓" />

            </LinearLayout>

            <!-- Dinner pill -->
            <LinearLayout
                android:id="@+id/pillDinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_taken"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/ivDinnerIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_dinner"
                    android:contentDescription="@string/label_dinner"
                    app:tint="@color/status_green" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDinnerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="11sp"
                    android:textColor="@color/status_green"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    tools:text="Dinner ✓" />

            </LinearLayout>

            <!-- Skipped pill -->
            <LinearLayout
                android:id="@+id/pillSkipped"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_skipped"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvSkippedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_skipped"
                    android:textSize="11sp"
                    android:textColor="@color/status_yellow"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02" />

            </LinearLayout>

        </LinearLayout>

        <!-- ─── Notes row ─── -->
        <LinearLayout
            android:id="@+id/layoutNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintStart_toEndOf="@id/dateBadge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutStatusPills">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_edit_note"
                android:contentDescription="@null"
                android:alpha="0.5"
                app:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvNotes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="italic"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Skipped due to travel" />

        </LinearLayout>

        <!-- ─── Divider before actions ─── -->
        <View
            android:id="@+id/dividerActions"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="14dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.5"
            app:layout_constraintStart_toEndOf="@id/viewAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutNotes" />

        <!-- ─── Action buttons row ─── -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toEndOf="@id/viewAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerActions">

            <!-- Edit button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="@string/action_edit"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_edit_note"
                app:iconSize="16dp"
                app:iconTint="?attr/colorPrimary"
                app:iconPadding="4dp"
                app:cornerRadius="8dp" />

            <!-- Delete button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:layout_marginStart="4dp"
                android:text="@string/action_delete"
                android:textSize="12sp"
                android:textColor="@color/status_red"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconSize="16dp"
                app:iconTint="@color/status_red"
                app:iconPadding="4dp"
                app:cornerRadius="8dp"
                app:rippleColor="@color/status_red_container" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>